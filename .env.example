# Copia este archivo como .env y cambia los valores. El .env real NUNCA se sube al repo.

# --- Modo de la API de borde: demo | dev | keycloak -------------------------------
#   demo      sin Docker, motor de prueba (no es la arquitectura Secure)
#   dev       agente S real (PDP, Tool Gateway, RLS) con sesiones de prueba, sin Keycloak
#   keycloak  agente S real y tokens RS256 de Keycloak
ACXES_MODE=demo

# --- Modelo de lenguaje: mock (sin red) | real (Groq) ------------------------------
LLM_CLIENT=mock
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_AGENT=
LLM_MODEL_BULK=

# --- PostgreSQL -------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=acxes
POSTGRES_USER=acxes_owner
POSTGRES_PASSWORD=CAMBIAR_POSTGRES_OWNER
POSTGRES_APP_PASSWORD=CAMBIAR_POSTGRES_APP
POSTGRES_AUDIT_PASSWORD=CAMBIAR_POSTGRES_AUDIT
POSTGRES_PDP_PASSWORD=CAMBIAR_POSTGRES_PDP

# --- Recuperación: lexical (versión base) | hybrid (léxica + vectorial con RRF) -------
# En modo hybrid hace falta el extra: pip install -e ".[embeddings]"
# Cambiar de modo o de modelo exige volver a ingerir: python -m acxes.db.apply
RETRIEVAL_MODE=lexical
# local: modelo en el mismo proceso. hash: solo pruebas y CI
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RETRIEVAL_CANDIDATES=20
RRF_K=60
# Similitud coseno mínima de la rama vectorial, calibrada para bge-m3. Recalíbrela si
# cambia EMBEDDING_MODEL
EMBEDDING_MIN_SIMILARITY=0.48

# --- Keycloak (solo ACXES_MODE=keycloak) --------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_KEYCLOAK_ADMIN
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=acxes
KEYCLOAK_WEB_CLIENT_ID=acxes-chat-web
KEYCLOAK_API_AUDIENCE=acxes-chat-api

# --- Límite de solicitudes de chat por usuario y minuto (P13) -------------------------
RATE_LIMIT_PER_MINUTE=30
