# Copiar a .env. Nunca versionar .env ni poner valores reales en este archivo.

# Modelo de lenguaje (agnóstico de proveedor)
# mock o real. El CI siempre usa mock
LLM_CLIENT=mock
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_AGENT=
LLM_MODEL_BULK=

# PostgreSQL. Cambiar antes de usar fuera de una máquina local
POSTGRES_DB=acxes
POSTGRES_USER=acxes_owner
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_esta_clave
KEYCLOAK_PORT=8080
