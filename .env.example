# Copia este archivo como .env y cambia los valores. El .env real NUNCA se sube al repo.

# --- Modo de la API de borde: demo | dev | keycloak -------------------------------
#   demo      sin Docker, motor de prueba (no es la arquitectura Secure)
#   dev       agente S real (PDP, Tool Gateway, RLS) con sesiones de prueba, sin Keycloak
#   keycloak  agente S real y tokens RS256 de Keycloak
ACXES_MODE=demo

# --- Modelo de lenguaje: mock (sin red) | real (Groq) ------------------------------
LLM_CLIENT=mock
LLM_API_KEY=pega_aqui_tu_clave_solo_si_usas_real

# --- PostgreSQL -------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=acxes
POSTGRES_USER=acxes_owner
POSTGRES_PASSWORD=cambia_esto
POSTGRES_APP_PASSWORD=cambia_esto
POSTGRES_AUDIT_PASSWORD=cambia_esto
POSTGRES_PDP_PASSWORD=cambia_esto

# --- Keycloak (solo ACXES_MODE=keycloak) --------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambia_esto
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=acxes
KEYCLOAK_WEB_CLIENT_ID=acxes-chat-web
KEYCLOAK_API_AUDIENCE=acxes-chat-api

# --- Límite de solicitudes de chat por usuario y minuto (P13) -------------------------
RATE_LIMIT_PER_MINUTE=30
