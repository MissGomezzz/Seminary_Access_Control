# Copiar a .env. Nunca versionar .env ni poner valores reales en este archivo.

# Modelo de lenguaje detrás de la interfaz LLMClient
# mock o real. El CI siempre usa mock
LLM_CLIENT=mock
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
# Clave de Groq. Solo en .env
LLM_API_KEY=
# Identificadores de modelos de producción con uso de herramientas, verificados en la documentación de Groq el 2026-09-21.
# openai/gpt-oss-120b es el que pasó la prueba de aceptación de B1. Revisar la documentación vigente antes de cambiarlos
LLM_MODEL_AGENT=openai/gpt-oss-120b
LLM_MODEL_BULK=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Límites comunes a B1 y S
AGENT_MAX_ITERATIONS=4
RETRIEVAL_K=5

# PostgreSQL. Cambiar antes de usar fuera de una máquina local
POSTGRES_DB=acxes
POSTGRES_USER=acxes_owner
POSTGRES_PASSWORD=cambiar_esta_clave
# Claves de los roles de aplicación y de auditoría. Las usa `python -m acxes.db.apply`
POSTGRES_APP_PASSWORD=cambiar_esta_clave_app
POSTGRES_AUDIT_PASSWORD=cambiar_esta_clave_auditoria
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_esta_clave
KEYCLOAK_PORT=8080
